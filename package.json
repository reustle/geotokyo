{
	"name": "geotokyo-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devEngines": {
	"packageManager":  {
	  "name": "pnpm",
	  "version": "12.4.1"
	},
	"runtime": {
      "name": "node",
      "version": "24"
    }
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"thumbnails": "node scripts/fetch-thumbnails.mjs",
		"link-meta": "node scripts/link-meta.mjs",
		"set-thumbnail": "node scripts/set-thumbnail.mjs",
		"start": "serve build -l ${PORT:-3000}",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.63.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"serve": "^14.2.6",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	}
}
